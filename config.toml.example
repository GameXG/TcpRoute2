# TcpRoute2 配置文件
# https://github.com/GameXG/TcpRoute2

# 监听地址
# 同一端口提供 SOCKS4、SOCKS4a、SOCKS5、HTTP 代理和 HTTPS CONNECT。
addr="127.0.0.1:7070"

# DNS sources are optional. Lower Priority runs first; ties keep TOML order.
# Failed/unusable DoH responses fall back to the next source, then system DNS.
# A valid NXDOMAIN is final. DoH uses direct HTTPS with system bootstrap DNS.
#[[Dns]]
#Type="doh"
#URL="https://cloudflare-dns.com/dns-query"
#Priority=10
#Timeout="3s"

# 可选 hosts 规则源：支持本地 hosts 文件或 HTTP/HTTPS 远程规则。
#[[Hosts]]
#Path="hosts/local.txt"
#Type="base"
#Credit=0
#UpdateInterval="24h"
# Type 支持 base、suffix、pan、regex；同一域名可提供多个候选地址。
# DnsResolve=true 时，命中 Host 就只使用其地址；未命中才查询 DNS。
# 同一域名的多个 Host 地址可竞速；过滤或连接失败不会回退到 DNS。

# 客户端已经把域名解析为 IP 时，从 HTTP Host/TLS SNI 恢复域名。
# 默认分别为 [80] 和 [443]；设置 [0] 可关闭对应协议的纠正。
#PreHttpPorts=[80]
#PreHttpsPorts=[443]

# 可以使用的线路列表
# 连接网络时会自动选择最快的线路。
# 建议显式保留直连线路；未配置时核心会自动补入内置 Direct。

[[UpStreams]]
Name="direct"
ProxyUrl="direct://0.0.0.0:0000"
# 是否执行本地dns解析
DnsResolve=true


[[UpStreams]]
Name="https-proxy.com"
# 代理地址
# 通过 https://github.com/GameXG/ProxyClient 实现的代理功能
# 目前支持以下格式
# http 代理 http://123.123.123.123:8088
# https 代理 https://123.123.123.123:8088
# socks5 代理，可用完整 URL 级联：socks5://123.123.123.123:5050?upProxy=http://145.2.1.3:8080
# 也可引用另一个上游 Name：?upProxy=entry；支持前向和多级引用。
# 可在前置线路单独设置 DialProxyFor="目标Name"，载入时绑定为目标的前置。
# DialProxyFor 与本线路 URL 的 upProxy 互斥，目标也不能配置 upProxy。
# 多个前置指向同一目标时组成多条链路竞速；各节点也保留普通请求选路资格及自身策略。
# 名称区分大小写；仅复用 ProxyUrl，不继承规则、DnsResolve、Credit 或延迟。
# 名称引用支持 http/https/socks4/socks4a/socks5 和 Xray 扩展协议 URL；直连不能接收。
# shadowsocks 代理 shadowsocks://method:password@123.123.123:5050
# shadowsocks/vmess/vless/trojan/wireguard/hysteria2 由 ProxyClient 内置 xray-core 统一处理（兼容 ss/hysteria/hy2）
# vmess 示例 vmess://base64(json)
# vless 示例 vless://uuid@host:443?encryption=none&security=tls&type=ws&host=example.com&path=%2F
# trojan 示例 trojan://password@host:443?security=tls&type=ws&sni=example.com&host=example.com&path=%2F
# wireguard 示例 wireguard://secretKey@engage.cloudflareclient.com:2408?publicKey=peerPublicKey&address=172.16.0.2%2F32&allowedIPs=0.0.0.0%2F0,::%2F0
# hysteria2 示例 hysteria2://password@host:443?sni=example.com&insecure=0&alpn=h3
# 直连 direct://0.0.0.0:0000/?LocalAddr=123.123.123.123:0
ProxyUrl="https://www.proxy.com:443"
DnsResolve=false

# 线路的信誉度，不会通过信誉度低于0的代理建立明文协议的连接(http、ftp、stmp等)
Credit=0

# 使用本线路前等待的时间(单位毫秒)
# 国内 baidu、qq tcping一般是30ms，这里设置为80ms(0.08秒)。
# 可以使得大部分国内站点不会尝试通过代理访问，降低上游代理的负担。
# 0.08秒的延迟很低，并且建立连接后会缓存最快连接记录，不会再次延迟，所以不建议删除。
Sleep=80

# 修正延迟
# shadowsocks 协议并不会报告是否连接到了目标网站，所以无法获得真实的到目标网站的 tcpping。
# 目前只能通过 shadowsocks 服务器 tcpping + CorrectDelay 来估算。
# 非 shadowsocks 协议不用设置，shadowsocks 协议建议设置为50-100.
CorrectDelay=0

# 分流规则属于当前上游，可配置多个白名单和黑名单来源。
# 本地/远程文件通过 Type 指定每行的匹配方式：base、suffix、pan、regex。
#[[UpStreams.Whitelist]]
#Path="rules/proxy.txt"
#Type="suffix"

#[[UpStreams.Whitelist]]
#Path="https://example.com/proxy.txt"
#Type="suffix"
#UpdateInterval="24h"

# Geosite 从 TcpRoute2 程序所在目录加载 geosite.dat；文件缺少时启动报错。
#[[UpStreams.Whitelist]]
#Type="geosite"
#Path="geosite:apple,geosite:google"

# GeoIP 匹配没有域名的 IPv4/IPv6 目标；内置数据文件由客户端统一管理。
#[[UpStreams.Whitelist]]
#Type="geoip"
#Path="geoip:cn,geoip:private"
